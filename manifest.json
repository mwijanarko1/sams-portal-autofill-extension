{
  "manifest_version": 3,
  "name": "SAMS Portal Autofill",
  "version": "0.1.0",
  "description": "Autofill university portal forms using SAMS CRM student data. Local/demo only.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SAMS Portal Autofill"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
