{
  "name": "sams-portal-autofill-extension",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs dev",
    "build:prod": "node scripts/build.mjs prod",
    "build:safari": "node scripts/build.mjs dev safari",
    "build:safari:prod": "node scripts/build.mjs prod safari",
    "build:safari:app": "node scripts/package-safari.mjs",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 e2e/extension.e2e.mjs",
    "test:e2e:fill-all": "node --test --test-concurrency=1 e2e/fill-all.e2e.mjs",
    "test:e2e:fill-all:portals": "node --test --test-concurrency=1 e2e/fill-all-portals.e2e.mjs",
    "test:e2e:live": "node e2e/live.mjs",
    "safari:fixtures": "node e2e/safari/serve-fixtures.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
