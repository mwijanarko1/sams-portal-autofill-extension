{
  "manifest_version": 3,
  "name": "SAMS Portal Autofill",
  "version": "0.2.0",
  "description": "Copy visible student data from SAMS CRM and fill approved university portal drafts.",
  "permissions": ["storage", "activeTab", "scripting", "alarms", "webNavigation"],
  "host_permissions": [
    "https://app.samscrm.co.uk/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SAMS Portal Autofill"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
